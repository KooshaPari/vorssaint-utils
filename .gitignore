# Build artifacts
build/
dist/
.build/
*.dmg

# Signing material: never commit private keys or notary credentials
*.p12
*.pem
*.cer
*.p8
*.key
*.mobileprovision
*.keychain-db

# Local-only working notes
AGENTS.md
CLAUDE.md

# Local probe dumps: diagnostic output stays in scratch (E:\koosh\Agents\scratch),
# never at the repo root. The ocgo pool answers /pool and /v1/usage with key
# values in plaintext, so any captured response is secret material.
/ERR
/*pool*.json
/*usage*.txt

# macOS noise
.DS_Store

# Xcode / SwiftPM user state
*.xcodeproj
xcuserdata/
.swiftpm/
